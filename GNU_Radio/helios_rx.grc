- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\nimport struct\n\ndef pn9(n):\n    state = 0b111111111\n\
      \    out = []\n    for _ in range(n):\n        out.append(state & 0xFF)\n  \
      \      for _ in range(8):\n            feed_back_bit = ((state >> 5) ^ (state))\
      \ & 1\n            state = (state >> 1) | (feed_back_bit << 8)\n    return out\n\
      \n\ndef crc_16(data):\n    crc = 0xFFFF\n    crc_polynomial = 0x8005\n    for\
      \ byte in data:\n        for _ in range(8):\n            if(((crc & 0x8000)\
      \ >> 8) ^ (byte & 0x80)):\n                crc = (crc << 1) ^ crc_polynomial\n\
      \            else:\n                crc = crc << 1\n            \n         \
      \   crc = crc & 0xFFFF\n            byte = (byte << 1) & 0xFF\n    return crc\n\
      \n\n\nclass blk(gr.sync_block):\n    def __init__(self, tag_name=\"sync\"):\
      \           # shows up as a parameter in GRC\n        gr.sync_block.__init__(self,\
      \ name=\"HeliosLink deframer\", in_sig=[np.uint8], out_sig=None)\n        self.tag_name\
      \ = tag_name\n        self.white = pn9(64)                # PN9 table, made\
      \ once\n        self.collecting = False\n        self.bits = []            \
      \       # bits of the packet being collected\n        self.need = 0        \
      \            # total bits this packet has\n        self.last_id = None\n   \
      \     self.good = 0\n        self.lost = 0\n\n    def work(self, input_items,\
      \ output_items):\n        bits = input_items[0]\n        start = self.nitems_read(0)\n\
      \        tag_pos = set()\n        for tag in self.get_tags_in_window(0, 0, len(bits)):\n\
      \            if pmt.symbol_to_string(tag.key) == self.tag_name:\n          \
      \      tag_pos.add(tag.offset - start)\n\n        for i in range(len(bits)):\n\
      \            if not self.collecting:\n                if i not in tag_pos:\n\
      \                    continue  # keep waiting (IDLE)\n                self.collecting\
      \ = True\n                self.bits = []\n                self.need = 0\n  \
      \          self.bits.append(int(bits[i]))\n            if len(self.bits) ==\
      \ 8:\n                L = int(np.packbits(self.bits)[0]) ^ self.white[0]  #\
      \ packs into bytes\n                if ((L < 2) or (L > 61)):  # impossible\
      \ length it was a false sync buffer is 64 bytes in cc1101 61 + 1 itself + RSSI\
      \ and LQI/CRC_OK = 64\n                    self.collecting = False\n       \
      \             self.bits = []\n                    self.need = 0\n          \
      \          continue\n                self.need = (1 + L + 2) * 8  # length byte\
      \ + L + 2 CRC, in bits\n            if len(self.bits) == self.need:\n      \
      \          self.handle_packet()\n                self.collecting = False\n \
      \               self.bits = []\n                self.need = 0\n        return\
      \ len(bits)\n\n    def handle_packet(self):\n        raw = np.packbits(self.bits).tolist()\n\
      \        white = self.white\n        dewhitened_bits = [r ^ w for r, w in zip(raw,\
      \ white)]\n        Length = dewhitened_bits[0]\n        crc_rx = dewhitened_bits[Length\
      \ + 1] << 8 | dewhitened_bits[Length + 2]  # the 2 received CRC bytes as one\
      \ 16-bit number, length does not count itself so indexing is correct\n     \
      \   if (crc_16(dewhitened_bits[:Length + 1]) ^ crc_rx):\n            print(\"\
      CRC FAIL\")\n            return\n        self.good += 1\n        pid, cmd =\
      \ dewhitened_bits[1], dewhitened_bits[2]\n        if self.last_id is not None:\n\
      \            self.lost += (pid - self.last_id - 1) & 0xFF\n        self.last_id\
      \ = pid\n        payload = dewhitened_bits[3:Length + 1] # voltage_mv, temp_c10,\
      \ uptime_s from d[3 : L+1]\n        v, t, up = struct.unpack(\"<HhI\", bytes(payload))\n\
      \        print(f\"id={pid} cmd={cmd} V={v} mV T={t/10:.1f} C up={up} s lost={self.lost}\"\
      , flush=True)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tag_name: '''sync'''
  states:
    _io_cache: ('HeliosLink deframer', 'blk', [('tag_name', "'sync'")], [('0', 'byte',
      1)], [], '', ['tag_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 596.0]
    rotation: 180
    state: enabled
